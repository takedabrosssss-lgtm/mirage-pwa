# Local development only. Never commit real production secrets.
APP_ENV=development
APP_SECRET=local-development-only-change-me
DATABASE_URL=sqlite:///./data/mirage.db
MARKET_REGION_LABEL=local-development
SERVER_REGION_LABEL=local-development
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market/stream?streams=!markPrice@arr@1s/!bookTicker/!ticker@arr
SCAN_UNIVERSE_SIZE=10
LOG_LEVEL=INFO
# Optional: exactly four accounts, only used on an empty database.
# BOOTSTRAP_USERS_JSON=[]
